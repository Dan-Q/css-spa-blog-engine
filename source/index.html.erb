<!doctype html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>A Static Single Page Blog</title>
    <link rel="stylesheet" href="stylesheets/blog.css">
  </head>
  <body>
    <h1>
      A Static Single Page Blog
    </h1>

    <article id="index">
      <h2>Posts</h2>
      <ul>
        <% posts.each do |post| %>
          <li><a href="#<%= post['id'] %>"><%= post['title'] %> (<%= post['date'] %>)</a></li>
        <% end %>
      </ul>
    </article>

    <% posts.each do |post| %>
      <article id="<%= post['id'] %>">
        <h2><%= post['title'] %></h2>
        <%= post['content'] %>
        <p><a href="#">Back home</a></p>
      </article>
    <% end %>
  </body>
</html>
